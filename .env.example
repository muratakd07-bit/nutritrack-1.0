# NutriTrack — ortam değişkeni şablonu.
# Bu dosyayı .env.local olarak kopyala ve gerçek değerlerle doldur.
# GERÇEK DEĞERLERİ ASLA COMMIT ETME — .env* dosyaları .gitignore içinde.

# PostgreSQL bağlantı adresi (Supabase Project Settings > Database > Connection string).
# Yerel geliştirme için Docker/local Postgres de kullanılabilir.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase proje ayarları (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Yalnızca sunucu tarafında kullanılır — asla client bundle'a sızmamalı,
# asla NEXT_PUBLIC_ önekiyle tanımlanmamalıdır.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
