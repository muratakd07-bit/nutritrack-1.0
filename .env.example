# NutriTrack — ortam değişkeni şablonu.
# Bu dosyayı .env.local olarak kopyala ve gerçek değerlerle doldur.
# GERÇEK DEĞERLERİ ASLA COMMIT ETME — .env* dosyaları .gitignore içinde.

# PostgreSQL bağlantı adresi.
# Supabase Dashboard > Project Settings > Database > Connection string bölümünden
# "Direct connection" (port 5432) seçeneğini kopyala — "Transaction pooler"
# (port 6543/pgbouncer) DEĞİL. Sebep: hem migration'lar (prisma.config.ts) hem
# runtime (lib/db/prisma.ts) şu an AYNI DATABASE_URL'i kullanıyor; pgbouncer'ın
# transaction modu Prisma migration'larıyla uyumlu olmayabilir. İleride
# serverless ortamda bağlantı limiti sorunu yaşanırsa runtime için ayrı,
# havuzlanmış bir bağlantı eklemek gündeme gelebilir (henüz eklenmedi).
# Yerel geliştirme için Docker/local Postgres de kullanılabilir.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase proje ayarları (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Yalnızca sunucu tarafında kullanılır — asla client bundle'a sızmamalı,
# asla NEXT_PUBLIC_ önekiyle tanımlanmamalıdır.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# USDA FoodData Central API anahtarı (scripts/import-usda-foods.ts için).
# Ücretsiz, kayıt gerektirir: https://api.data.gov/signup/
# Tanımlanmazsa USDA'nın herkese açık DEMO_KEY'i kullanılır — bu anahtar
# ÇOK DÜŞÜK ve PAYLAŞILAN bir rate limite sahiptir (saatte birkaç istek),
# gerçek/ölçekli import için kendi anahtarınızı almanız gerekir.
USDA_FDC_API_KEY=""

# Qwen3-VL (fotoğraftan besin tanıma) — bkz. domain/nutrition/foodRecognition.ts.
# Tanımlanmazsa fotoğraf analizi 501 (Not Implemented) döner — uydurma bir
# sonuç ASLA döndürülmez. QWEN3_VL_ENDPOINT_URL/API_KEY istek-yanıt şekli
# HENÜZ GERÇEK BİR ENDPOINT'E KARŞI DOĞRULANMADI (bkz. qwen3vlClient.ts'teki
# not) — gerçek bir sağlayıcı bağlanınca eşleme kontrol edilmelidir.
QWEN3_VL_ENDPOINT_URL=""
QWEN3_VL_API_KEY=""

# Yalnızca geliştirme/deneme amaçlı: "mock" set edilirse fotoğraf analizi
# gerçek AI yerine deterministik sahte sonuçlar döner (bkz.
# domain/nutrition/foodRecognitionMock.ts). PRODUCTION'DA ASLA "mock"
# OLARAK BIRAKILMAMALIDIR — bu, kullanıcıya sahte veriyi gerçekmiş gibi
# gösterir (fakat nutrition DEĞERLERİ yine de her zaman gerçek ADIM 16
# hesaplamasından gelir, mock yalnızca besin TANIMA adımını etkiler).
AI_FOOD_RECOGNITION_MODE=""
