# NutriTrack — ortam değişkeni şablonu.
# Bu dosyayı .env.local olarak kopyala ve gerçek değerlerle doldur.
# GERÇEK DEĞERLERİ ASLA COMMIT ETME — .env* dosyaları .gitignore içinde.

# PostgreSQL bağlantı adresi.
# Supabase Dashboard > Project Settings > Database > Connection string bölümünden
# "Direct connection" (port 5432) seçeneğini kopyala — "Transaction pooler"
# (port 6543/pgbouncer) DEĞİL. Sebep: hem migration'lar (prisma.config.ts) hem
# runtime (lib/db/prisma.ts) şu an AYNI DATABASE_URL'i kullanıyor; pgbouncer'ın
# transaction modu Prisma migration'larıyla uyumlu olmayabilir. İleride
# serverless ortamda bağlantı limiti sorunu yaşanırsa runtime için ayrı,
# havuzlanmış bir bağlantı eklemek gündeme gelebilir (henüz eklenmedi).
# Yerel geliştirme için Docker/local Postgres de kullanılabilir.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase proje ayarları (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Yalnızca sunucu tarafında kullanılır — asla client bundle'a sızmamalı,
# asla NEXT_PUBLIC_ önekiyle tanımlanmamalıdır.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
